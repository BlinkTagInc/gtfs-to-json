{
  "name": "gtfs-to-json",
  "version": "0.1.3",
  "private": false,
  "description": "Generate JSON of transit route data from a GTFS file",
  "keywords": [
    "transit",
    "gtfs",
    "transportation"
  ],
  "license": "MIT",
  "author": "Brendan Nee <brendan@blinktag.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "gtfs-to-json": "dist/bin/gtfs-to-json.js"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "husky"
  },
  "dependencies": {
    "cli-table": "^0.3.11",
    "gtfs": "^4.19.4",
    "lodash-es": "^4.18.1",
    "pretty-error": "^4.0.0",
    "sanitize-filename": "^1.6.4",
    "timer-machine": "^1.1.0",
    "yargs": "^18.0.0",
    "yoctocolors": "^2.1.2"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.5",
    "@types/timer-machine": "^1.1.3",
    "@types/yargs": "^17.0.35",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "tsdown": "^0.22.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22"
  },
  "release-it": {
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/keep-a-changelog": {
        "filename": "CHANGELOG.md"
      }
    },
    "hooks": {
      "after:bump": "npm run build"
    }
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "*.js": "prettier --write",
    "*.json": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
